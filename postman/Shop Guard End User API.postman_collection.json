              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"ANDROID\",\n  \"token\": \"{{push_token}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/end-user/push-token"
          }
        },
        {
          "name": "Deactivate Push Token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{push_token}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/end-user/push-token"
          }
        }
      ]
    }
  ]
}
